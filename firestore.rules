rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'darkdesire389@gmail.com' ||
        (request.auth.token.keys().hasAny(['isAdmin']) && request.auth.token.isAdmin == true) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isOwner(userId) {
       return request.auth != null && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    // Products: Public Read, Admin Write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews: Approved Public Read, Owner/Admin Read pending. Admin Write.
    // Users can create reviews (pending approval).
    match /product_ratings/{ratingId} {
       allow read: if resource.data.status == 'approved' || (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
       allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
       allow update: if isAdmin(); // Only admin can approve/reject
       allow delete: if isAdmin();
    }

    // Flash Sale: Public Read, Admin Write
    match /flash_sale/current {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Notifications: Public Create (Notify Me), No Public Read/Update
    match /notifications/{notificationId} {
      allow create: if true;
      allow read, update, delete: if false; // Backend only processing
    }

    // Users: Owner/Admin Read. Owner/Admin Write (Protected Fields)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Create: Allow if user is authenticated and ID matches. Prevent setting isAdmin = true.
      allow create: if isOwner(userId) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);

      // Update: Allow if user is owner or admin.
      // If owner, strictly prevent changing 'isAdmin' or 'loyaltyPoints' fields.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'loyaltyPoints']))
      );
    }

    // Orders: Owner/Admin Read. Admin Update/Delete. Backend creates.
    match /orders/{orderId} {
        allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
        allow update, delete: if isAdmin();
        allow create: if false; // Only backend creates orders
    }

    // Contact Messages: Public Create, Admin Read
     match /contact_messages/{messageId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
     }

     // Newsletter: Public Create, Admin Read
     match /newsletter_subscriptions/{subscriptionId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
     }

     // Backend Only Collections
     match /stripe_sessions/{sessionId} {
        allow read, write: if false;
     }

     match /aliexpress_tokens/{userId} {
         allow read, write: if false;
     }

     match /aliexpress_auth_states/{userId} {
         allow read, write: if false;
     }
  }
}
