rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'darkdesire389@gmail.com' ||
        (request.auth.token.keys().hasAny(['isAdmin']) && request.auth.token.isAdmin == true) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // Allow public read-only access to products.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Allow users to create notification requests, but not read, update or delete them.
    // This is a public-facing feature.
    match /notifications/{notificationId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Allow users to read and write to their own user document.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      // Allow creation if authenticated and uid matches, but enforce isAdmin to be false or missing
      allow create: if request.auth.uid == userId &&
                    (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      // Allow update if authenticated and uid matches, but ensure isAdmin is not changed to true
      allow update: if isAdmin() || (
                      request.auth.uid == userId &&
                      (
                        !('isAdmin' in request.resource.data) ||
                        request.resource.data.isAdmin == resource.data.isAdmin
                      )
                    );
    }

    // Allow users to read their own orders. Admins can read all orders.
    match /orders/{orderId} {
        allow read: if request.auth.uid == resource.data.userId || isAdmin();
        // Only admins can write (update/delete). Creation is done by backend (cloud functions) generally,
        // but if client creates it, we might need to allow create.
        // Based on app.js 'placeOrder' calls stripe and then cloud function fulfills order.
        // But let's see if there are other places.
        // app.js doesn't seem to write to 'orders' directly except maybe updateOrderStatus in admin.
        allow write: if isAdmin();
    }

    // Allow public read-only access to approved ratings, let users read their own, and let admins read all.
    match /product_ratings/{ratingId} {
      allow read: if resource.data.status == 'approved' || (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
      allow create: if request.auth.uid != null;
      allow update, delete: if isAdmin();
    }

    // Allow public read-only access to flash sale.
    match /flash_sale/current {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Allow public to write to contact messages? Original rule restricted to admin.
    // Assuming we want to fix this if it blocks users, but for now sticking to Admin errors reported.
    // But if I use isAdmin(), I should update these too.
    // If these are for public contact form, they should allow create if true (or authenticated).
    // app.js initContactForm uses addDoc.
     match /contact_messages/{messageId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
     }

     match /newsletter_subscriptions/{subscriptionId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
     }

     // Also allow admins to read/write stripe sessions if needed, or locking it down.
     match /stripe_sessions/{sessionId} {
        allow read, write: if false; // Only backend
     }

     // Alieexpress tokens
     match /aliexpress_tokens/{userId} {
         allow read, write: if false; // Only backend
     }

     match /aliexpress_auth_states/{userId} {
         allow read, write: if false; // Only backend
     }
  }
}
